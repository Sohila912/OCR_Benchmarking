{
  "$defs": {
    "BoundingBox": {
      "additionalProperties": false,
      "description": "Axis-aligned bounds in the declared page coordinate system.\n\nCoordinates are minimum/maximum values, regardless of origin. Normalized\ncoordinates lie within [0, 1]; other coordinates retain provider values.",
      "properties": {
        "x_min": {
          "title": "X Min",
          "type": "number"
        },
        "y_min": {
          "title": "Y Min",
          "type": "number"
        },
        "x_max": {
          "title": "X Max",
          "type": "number"
        },
        "y_max": {
          "title": "Y Max",
          "type": "number"
        },
        "units": {
          "enum": [
            "pixels",
            "points",
            "normalized"
          ],
          "title": "Units",
          "type": "string"
        },
        "origin": {
          "enum": [
            "top_left",
            "bottom_left"
          ],
          "title": "Origin",
          "type": "string"
        }
      },
      "required": [
        "x_min",
        "y_min",
        "x_max",
        "y_max",
        "units",
        "origin"
      ],
      "title": "BoundingBox",
      "type": "object"
    },
    "JsonValue": {},
    "OCRBlock": {
      "additionalProperties": false,
      "description": "A provider-reported block; absent information remains null.\n\nReading order is zero-based when supplied. Confidence is normalized to\n[0, 1], not calibrated across providers. If an adapter rescales confidence,\nit must retain the original value and scale in provider_metadata.",
      "properties": {
        "block_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Block Id"
        },
        "text_start": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text Start"
        },
        "text_end": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text End"
        },
        "block_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Block Type"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        },
        "markdown": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Markdown"
        },
        "language": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Language"
        },
        "reading_order": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reading Order"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "bounding_box": {
          "anyOf": [
            {
              "$ref": "#/$defs/BoundingBox"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "provider_metadata": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Provider Metadata",
          "type": "object"
        }
      },
      "title": "OCRBlock",
      "type": "object"
    },
    "OCRIssue": {
      "additionalProperties": false,
      "description": "An explicit warning or error, optionally associated with a page.",
      "properties": {
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "page_number": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page Number"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "OCRIssue",
      "type": "object"
    },
    "OCRPage": {
      "additionalProperties": false,
      "description": "A one-based page; null blocks mean block information is unavailable.",
      "properties": {
        "page_number": {
          "minimum": 1,
          "title": "Page Number",
          "type": "integer"
        },
        "text_start": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text Start"
        },
        "text_end": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text End"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        },
        "markdown": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Markdown"
        },
        "language": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Language"
        },
        "width": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Width"
        },
        "height": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Height"
        },
        "dimension_units": {
          "anyOf": [
            {
              "enum": [
                "pixels",
                "points",
                "normalized"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dimension Units"
        },
        "blocks": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/OCRBlock"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Blocks"
        },
        "warnings": {
          "items": {
            "$ref": "#/$defs/OCRIssue"
          },
          "title": "Warnings",
          "type": "array"
        },
        "errors": {
          "items": {
            "$ref": "#/$defs/OCRIssue"
          },
          "title": "Errors",
          "type": "array"
        }
      },
      "required": [
        "page_number"
      ],
      "title": "OCRPage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Document output and provenance, without inventing provider capabilities.\n\nThe caller supplies document identity. Model/version are null when unknown;\ntext, Markdown, language and page information are null when unavailable.\nEmpty issue lists mean no issues were reported, not verified correctness.",
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "document_id": {
      "minLength": 1,
      "title": "Document Id",
      "type": "string"
    },
    "filename": {
      "minLength": 1,
      "title": "Filename",
      "type": "string"
    },
    "source": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source"
    },
    "source_metadata": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Source Metadata",
      "type": "object"
    },
    "provider": {
      "minLength": 1,
      "title": "Provider",
      "type": "string"
    },
    "model_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Name"
    },
    "model_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Version"
    },
    "text": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Text"
    },
    "markdown": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Markdown"
    },
    "language": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Language"
    },
    "pages": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/OCRPage"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Pages"
    },
    "warnings": {
      "items": {
        "$ref": "#/$defs/OCRIssue"
      },
      "title": "Warnings",
      "type": "array"
    },
    "errors": {
      "items": {
        "$ref": "#/$defs/OCRIssue"
      },
      "title": "Errors",
      "type": "array"
    },
    "provider_metadata": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Provider Metadata",
      "type": "object"
    }
  },
  "required": [
    "document_id",
    "filename",
    "provider"
  ],
  "title": "OCRResult",
  "type": "object"
}