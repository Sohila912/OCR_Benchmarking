# Copy to .env. Application loads repository-root .env; environment takes precedence.
# Paths below are portable and relative to the repository root. Do not add secrets.
OCR_PROVIDER=tesseract
OCR_UPLOAD_DIR=runtime/uploads
OCR_TEMP_DIR=runtime/tmp
OCR_OUTPUT_DIR=runtime/outputs
OCR_PDF_DPI=300
OCR_TESSERACT_CMD=tesseract
OCR_TESSERACT_LANG=eng
OCR_API_HOST=127.0.0.1
OCR_API_PORT=8000
OCR_API_URL=http://127.0.0.1:8000
OCR_MAX_UPLOAD_BYTES=52428800
OCR_MAX_PAGES=100
OCR_OPERATION_TIMEOUT=120
OCR_PADDLE_DEVICE=cpu
OCR_DOCLING_DEVICE=cpu

# Optional paths: omit when unused; do not assign empty strings.
# OCR_POPPLER_PATH=tools/poppler/Library/bin
# OCR_PADDLE_VL_MODEL_DIR=models/PaddleOCR-VL-1.6
# OCR_PADDLE_LAYOUT_MODEL_DIR=models/PP-DocLayoutV3
# OCR_DOCLING_ARTIFACTS_PATH=models/docling

# Optional operator-recorded asset revisions; unknown revisions remain null.
# OCR_PADDLE_MODEL_REVISION=verified-model-commit
# OCR_DOCLING_MODEL_REVISION=verified-asset-manifest-version
# For mixed Arabic/English recognition, set OCR_TESSERACT_LANG=ara+eng.
