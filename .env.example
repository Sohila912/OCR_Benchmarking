# Copy to .env. Application loads repository-root .env; environment takes precedence.
# Paths below are portable and relative to the repository root. Do not add secrets.
OCR_PROVIDER=tesseract
OCR_UPLOAD_DIR=runtime/uploads
OCR_TEMP_DIR=runtime/tmp
OCR_OUTPUT_DIR=runtime/outputs
OCR_PDF_DPI=300
OCR_TESSERACT_CMD=tesseract
OCR_TESSERACT_LANG=eng
OCR_API_HOST=127.0.0.1
OCR_API_PORT=8000
OCR_API_URL=http://127.0.0.1:8000
OCR_MAX_UPLOAD_BYTES=52428800
OCR_MAX_PAGES=100
# Set false to remove request-uploaded PDFs after extraction, including failures.
# Normalized JSON outputs remain available; existing uploads are never removed.
OCR_RETAIN_UPLOADS=false
OCR_OPERATION_TIMEOUT=120
OCR_PADDLE_DEVICE=cpu
OCR_DOCLING_DEVICE=cpu
OLLAMA_HOST=http://localhost:11434
OLLAMA_OCR_MODEL=qwen2.5vl:3b
OLLAMA_KEEP_ALIVE=300
OLLAMA_OCR_TIMEOUT=1800
OLLAMA_NUM_CTX=4096

# Optional paths: omit when unused; do not assign empty strings.
# OCR_POPPLER_PATH=tools/poppler/Library/bin
# OCR_PADDLE_VL_MODEL_DIR=models/PaddleOCR-VL-1.6
# OCR_PADDLE_LAYOUT_MODEL_DIR=models/PP-DocLayoutV3
# OCR_DOCLING_ARTIFACTS_PATH=models/docling

# Optional operator-recorded asset revisions; unknown revisions remain null.
# OCR_PADDLE_MODEL_REVISION=verified-model-commit
# OCR_DOCLING_MODEL_REVISION=verified-asset-manifest-version
# For mixed Arabic/English recognition, set OCR_TESSERACT_LANG=ara+eng.

# Bound Qwen CPU vision work independently of other OCR providers.
OLLAMA_MAX_IMAGE_PIXELS=1000000

# Optional on GPUs too small for Qwen VL; omit for automatic GPU selection.
# OLLAMA_NUM_GPU=0

# Benchmark metrics-only SQLite history (text/PDF content is not stored).
OCR_BENCHMARK_DB=runtime/benchmarks.sqlite3
OCR_BENCHMARK_RETENTION_DAYS=90
# Docker API builds full CPU provider dependencies by default.
# OCR_INSTALL_LOCAL_MODELS=false
# Docker-specific host server URL; OLLAMA_HOST above is for local execution.
OLLAMA_DOCKER_HOST=http://host.docker.internal:11434

# CPU Paddle OOM safety floor; observed Docker capacity below 4 GiB was insufficient.
OCR_PADDLE_MIN_MEMORY_GIB=6
